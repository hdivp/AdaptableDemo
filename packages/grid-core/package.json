{
  "name": "@grid-aidlc/core",
  "version": "0.1.0",
  "description": "A wrapper around AG Grid. Takes data plus a config and renders a grid, with a plugin seam for higher level features.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "ag-grid-community": "^32.2.0",
    "ag-grid-enterprise": "^32.2.0",
    "ag-grid-react": "^32.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ag-grid-community": "^32.2.0",
    "ag-grid-enterprise": "^32.2.0",
    "ag-grid-react": "^32.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
